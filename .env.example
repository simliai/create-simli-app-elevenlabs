# Copy this file to .env.local and fill it in. Never commit .env.local.
# All of these are read on the server only. Do not prefix them with NEXT_PUBLIC_.

# Simli API key: https://app.simli.com (API key section of the dashboard)
SIMLI_API_KEY=

# Avatar to show. Default: Simli's default Trinity-2 face (a woman; the default voice in app/avatar.ts is female). Presets: https://docs.simli.com/api-reference/preset-faces
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04

# ElevenLabs API key: https://elevenlabs.io/app/settings/api-keys (free plan: see "ElevenLabs free plan" in the README).
# If you restrict the key, give it ElevenLabs Agents read + write access.
# The app creates and updates its own agent from app/avatar.ts: no dashboard setup needed.
ELEVENLABS_API_KEY=

# Optional. Use an agent you configured yourself in https://elevenlabs.io/app/agents
# (starts with agent_) instead of the one the app manages. That agent must output PCM 16000 Hz.
ELEVENLABS_AGENT_ID=

# Production safety switch. With NODE_ENV=production (next build / next start, Vercel) both
# session routes return 403 unless this is "true". Replace it with your own auth (see the
# TODOs in app/api/*/route.ts); set it only for demos or internal deploys.
ALLOW_UNAUTHENTICATED_SESSIONS=false
