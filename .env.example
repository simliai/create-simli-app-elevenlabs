# Copy this file to .env.local and fill it in. Never commit .env.local.
# All of these are read on the server only. Do not prefix them with NEXT_PUBLIC_.

# Simli API key: https://app.simli.com (API key section of the dashboard)
SIMLI_API_KEY=

# Avatar to show. Default: Simli's default Trinity-2 face (a woman: give the agent a female voice). Presets: https://docs.simli.com/api-reference/preset-faces
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04

# ElevenLabs API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs agent ID (starts with agent_): https://elevenlabs.io/app/agents
ELEVENLABS_AGENT_ID=

# Production safety switch. With NODE_ENV=production (next build / next start, Vercel) both
# session routes return 403 unless this is "true". Replace it with your own auth (see the
# TODOs in app/api/*/route.ts); set it only for demos or internal deploys.
ALLOW_UNAUTHENTICATED_SESSIONS=false
